@page
@model Sucursal360.Web.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Recuperacion no disponible";
}

<section class="login-shell">
    <div class="login-panel login-message-panel">
        <div class="login-brand">
            <span class="status-pill status-pill-info">DEMO</span>
            <p class="eyebrow">Sucursal 360</p>
            <h1>Recuperacion no disponible</h1>
            <p>La recuperacion de contrasena por correo no forma parte del demo V1.</p>
        </div>
        <div class="login-note">
            <strong>Acceso controlado</strong>
            <p>Solicite al administrador del demo una cuenta o una contrasena temporal.</p>
        </div>
        <a class="btn btn-primary" asp-page="./Login">Volver al inicio de sesion</a>
    </div>
</section>
