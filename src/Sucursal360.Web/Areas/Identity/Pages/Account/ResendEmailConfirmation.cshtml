@page
@model Sucursal360.Web.Areas.Identity.Pages.Account.ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Confirmacion no disponible";
}

<section class="login-shell">
    <div class="login-panel login-message-panel">
        <div class="login-brand">
            <span class="status-pill status-pill-info">DEMO</span>
            <p class="eyebrow">Sucursal 360</p>
            <h1>Confirmacion no disponible</h1>
            <p>El demo no envia correos de confirmacion. Las cuentas habilitadas son creadas por el administrador.</p>
        </div>
        <a class="btn btn-primary" asp-page="./Login">Volver al inicio de sesion</a>
    </div>
</section>
