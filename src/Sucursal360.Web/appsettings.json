{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "PublicData": {
    "Provider": "Demo",
    "Demo": {
      "FixturesPath": "Integrations/Demo/Fixtures"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "SeedUsers": {
    "Enabled": false
  },
  "DemoBootstrap": {
    "Enabled": false,
    "ResetDatabase": false,
    "OperationalMetricsCsvPath": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
