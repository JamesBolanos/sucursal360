@using System.Globalization
@model Sucursal360.Web.ViewModels.Dashboard.CorporateDashboardViewModel

@{
    ViewData["Title"] = "Panel gerencial";
}

<section class="dashboard-page">
    <header class="dashboard-topbar">
        <div>
            <p class="eyebrow">Sucursal 360</p>
            <h1>Panel gerencial</h1>
        </div>

        <form method="get" class="manager-filter-form" id="dashboardFilters">
            <div>
                <label asp-for="Filters.Month" class="form-label">Mes</label>
                <select asp-for="Filters.Month" name="Month" class="form-select" onchange="this.form.submit()">
                    @if (Model.MonthOptions.Count == 0)
                    {
                        <option value="">Sin datos</option>
                    }
                    @foreach (var month in Model.MonthOptions)
                    {
                        <option value="@month">@FormatMonth(month)</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="Filters.BranchId" class="form-label">Sucursal</label>
                <select asp-for="Filters.BranchId" name="BranchId" class="form-select" onchange="this.form.submit()">
                    <option value="">Todas</option>
                    @foreach (var branch in Model.BranchOptions)
                    {
                        <option value="@branch.Id">@branch.Code - @branch.Name</option>
                    }
                </select>
            </div>
        </form>
    </header>

    <section class="manager-dashboard-grid">
        <article class="executive-card executive-@Model.ExecutiveSummary.RiskTone">
            <div class="executive-copy">
                <span>@Model.ExecutiveSummary.ScopeLabel</span>
                <h2>@Model.ExecutiveSummary.Headline</h2>
                <p>@Model.ExecutiveSummary.Detail</p>
            </div>
            <div class="health-thermometer" aria-label="Salud @Model.ExecutiveSummary.HealthPercent por ciento">
                <div>
                    <span style="height: @Model.ExecutiveSummary.HealthPercent%;"></span>
                </div>
                <strong>@Model.ExecutiveSummary.RiskLabel</strong>
            </div>
        </article>

        <article class="dashboard-kpi-row" aria-label="Resumen ejecutivo">
            @foreach (var insight in Model.Insights)
            {
                <div class="dashboard-kpi insight-@insight.Tone">
                    <span>@insight.Label</span>
                    <strong>@insight.Value</strong>
                    <small>@insight.Detail</small>
                </div>
            }
        </article>

        <article class="chart-card sales-card">
            <div class="chart-card-header">
                <div>
                    <h2>Ventas</h2>
                    <p>Total: @FormatCurrency(Model.OperationalSummary.NetSales, Model.OperationalSummary.Currency)</p>
                </div>
                <span class="status-pill status-pill-muted">Datos simulados</span>
            </div>

            @if (Model.SalesSlices.Count == 0)
            {
                <div class="empty-state compact-empty">
                    <strong>No disponible</strong>
                    <p>Importe el CSV demo para mostrar ventas.</p>
                </div>
            }
            else
            {
                <div class="sales-visual">
                    <div class="pie-chart" style="background: @BuildPieGradient(Model.SalesSlices);" role="img" aria-label="Distribucion de ventas"></div>
                    <div class="pie-legend">
                        @foreach (var slice in Model.SalesSlices)
                        {
                            <div>
                                <span style="background: @slice.Color;"></span>
                                <strong>@slice.Label</strong>
                                <small>@slice.Percent.ToString("0.#")% - @FormatCurrency(slice.Value, Model.OperationalSummary.Currency)</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </article>

        <article class="chart-card ticket-card">
            <div class="chart-card-header">
                <div>
                    <h2>Ticket promedio</h2>
                    <p>@FormatCurrency(Model.OperationalSummary.AverageTicket, Model.OperationalSummary.Currency)</p>
                </div>
                <span class="status-pill status-pill-muted">Datos simulados</span>
            </div>

            @if (Model.TicketBars.Count == 0)
            {
                <div class="empty-state compact-empty">
                    <strong>No disponible</strong>
                    <p>Importe el CSV demo para mostrar ticket promedio.</p>
                </div>
            }
            else
            {
                <div class="ticket-bars" role="img" aria-label="Comparacion de ticket promedio">
                    @foreach (var bar in Model.TicketBars)
                    {
                        <div class="ticket-bar-row">
                            <span>@bar.Label</span>
                            <div>
                                <i style="width: @bar.Percent%; background: @bar.Color;"></i>
                            </div>
                            <strong>@FormatCurrency(bar.AverageTicket, Model.OperationalSummary.Currency)</strong>
                        </div>
                    }
                </div>
            }
        </article>
    </section>
</section>

@functions {
    private static string FormatCurrency(decimal? value, string currency)
    {
        return value is null ? "No disponible" : $"{currency} {value.Value:N2}";
    }

    private static string FormatCurrency(decimal value, string currency)
    {
        return $"{currency} {value:N2}";
    }

    private static string FormatMonth(string month)
    {
        if (DateOnly.TryParseExact($"{month}-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return date.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es-NI"));
        }

        return month;
    }

    private static string BuildPieGradient(IReadOnlyList<Sucursal360.Web.ViewModels.Dashboard.SalesSliceViewModel> slices)
    {
        var current = 0m;
        var parts = new List<string>();
        foreach (var slice in slices)
        {
            var next = current + slice.Percent;
            parts.Add($"{slice.Color} {FormatPercent(current)}% {FormatPercent(next)}%");
            current = next;
        }

        return $"conic-gradient({string.Join(", ", parts)})";
    }

    private static string FormatPercent(decimal value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture);
    }
}
