@model Sucursal360.Web.ViewModels.Dashboard.CorporateDashboardViewModel

@{
    ViewData["Title"] = "Panel corporativo";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Sucursal 360</p>
        <h1>Panel corporativo</h1>
    </div>
    <a class="btn btn-outline-primary" asp-controller="AdminIntegrations" asp-action="Index">Integraciones</a>
</section>

<section class="metric-grid mb-3" aria-label="Resumen corporativo">
    <article class="metric-tile">
        <span>Sucursales activas</span>
        <strong>@Model.Summary.ActiveBranches / @Model.Summary.TotalBranches</strong>
    </article>
    <article class="metric-tile">
        <span>Con datos publicos</span>
        <strong>@Model.Summary.BranchesWithSnapshots</strong>
    </article>
    <article class="metric-tile">
        <span>Rating promedio</span>
        <strong>@FormatDecimal(Model.Summary.AverageRating)</strong>
    </article>
    <article class="metric-tile">
        <span>Total de resenas</span>
        <strong>@FormatNumber(Model.Summary.TotalReviewCount)</strong>
    </article>
</section>

<section class="dashboard-focus mb-3">
    <div class="surface">
        <div class="surface-header">
            <div>
                <h2>Lectura rapida</h2>
                <p>Senales principales despues de la ultima sincronizacion.</p>
            </div>
        </div>

        <div class="insight-grid">
            @foreach (var insight in Model.Insights)
            {
                <article class="insight-item insight-@insight.Tone">
                    <span>@insight.Label</span>
                    <strong>@insight.Value</strong>
                    <small>@insight.Detail</small>
                </article>
            }
        </div>
    </div>

    <div class="surface">
        <div class="surface-header">
            <div>
                <h2>Ranking de sucursales</h2>
                <p>Rating publico actual y volumen de resenas.</p>
            </div>
        </div>

        <div class="ranking-list">
            @foreach (var item in Model.Ranking)
            {
                <a class="ranking-item" asp-controller="Branches" asp-action="Details" asp-route-id="@item.BranchId">
                    <span class="ranking-position">@item.Rank</span>
                    <span class="ranking-main">
                        <span class="ranking-title">@item.Code - @item.Name</span>
                        <span class="rating-bar" aria-hidden="true">
                            <span style="width: @item.RatingPercent%;"></span>
                        </span>
                    </span>
                    <span class="ranking-metrics">
                        <strong>@FormatDecimal(item.Rating)</strong>
                        <small>@FormatNumber(item.ReviewCount) resenas</small>
                    </span>
                </a>
            }
        </div>
    </div>
</section>

<section class="surface mb-3">
    <div class="surface-header">
        <div>
            <h2>Comparativo de reputacion publica</h2>
            <p>Fuente: proveedor demo local. Ultima sincronizacion: @FormatDate(Model.Summary.LastSynchronizationAtUtc).</p>
        </div>
        <span class="status-pill status-pill-info">Integracion demo</span>
    </div>

    <div class="table-responsive">
        <table class="table align-middle dashboard-table">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Sucursal</th>
                    <th>Estado</th>
                    <th>Rating</th>
                    <th>Var.</th>
                    <th>Resenas</th>
                    <th>Var.</th>
                    <th>Actualizado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var branch in Model.Branches)
                {
                    <tr>
                        <td class="fw-semibold">@branch.Code</td>
                        <td>
                            <div class="branch-cell">
                                <span>@branch.Name</span>
                                <small>@branch.Provider - @branch.ExternalPlaceId</small>
                            </div>
                        </td>
                        <td>
                            <span class="status-pill @DataStatusClass(branch.DataStatus)">@branch.DataStatus</span>
                            <span class="d-block mt-1 text-muted small">@branch.BusinessStatus</span>
                        </td>
                        <td class="metric-value">@FormatDecimal(branch.Rating)</td>
                        <td>@FormatDelta(branch.RatingDelta, "0.00")</td>
                        <td class="metric-value">@FormatNumber(branch.ReviewCount)</td>
                        <td>@FormatDelta(branch.ReviewCountDelta, "0")</td>
                        <td>@FormatDate(branch.RetrievedAtUtc)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Branches" asp-action="Details" asp-route-id="@branch.BranchId">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="surface">
    <div class="surface-header">
        <div>
            <h2>Resumen operativo</h2>
            <p>Datos simulados separados de la reputacion publica.</p>
        </div>
        <span class="status-pill status-pill-muted">@Model.OperationalSummary.SourceLabel</span>
    </div>

    @if (!Model.OperationalSummary.HasData)
    {
        <div class="empty-state">
            <strong>No disponible</strong>
            <p>Importe el CSV demo desde Datos simulados para mostrar ventas, transacciones y ticket promedio.</p>
        </div>
    }
    else
    {
        <dl class="detail-list">
            <div>
                <dt>Ventas netas</dt>
                <dd>@Model.OperationalSummary.Currency @FormatDecimal(Model.OperationalSummary.NetSales)</dd>
            </div>
            <div>
                <dt>Transacciones</dt>
                <dd>@FormatNumber(Model.OperationalSummary.TransactionCount)</dd>
            </div>
            <div>
                <dt>Ticket promedio</dt>
                <dd>@Model.OperationalSummary.Currency @FormatDecimal(Model.OperationalSummary.AverageTicket)</dd>
            </div>
        </dl>
    }
</section>

@functions {
    private static string FormatDecimal(decimal? value)
    {
        return value is null ? "No disponible" : value.Value.ToString("0.00");
    }

    private static string FormatNumber(int? value)
    {
        return value is null ? "No disponible" : value.Value.ToString("N0");
    }

    private static string FormatDate(DateTimeOffset? value)
    {
        return value is null ? "No disponible" : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private static string FormatDelta(decimal? value, string format)
    {
        if (value is null)
        {
            return "No disponible";
        }

        var prefix = value > 0 ? "+" : string.Empty;
        return $"{prefix}{value.Value.ToString(format)}";
    }

    private static string FormatDelta(int? value, string format)
    {
        if (value is null)
        {
            return "No disponible";
        }

        var prefix = value > 0 ? "+" : string.Empty;
        return $"{prefix}{value.Value.ToString(format)}";
    }

    private static string DataStatusClass(string status)
    {
        return status switch
        {
            "Actualizado" => "status-pill-success",
            "Sin sincronizar" => "status-pill-warning",
            _ => "status-pill-muted"
        };
    }
}
