<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sucursal 360</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sucursal360.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm app-navbar border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">Sucursal 360</a>
                <span class="status-pill status-pill-info me-2">DEMO</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.IsInRole(Sucursal360.Web.Security.AppRoles.Administrator) || User.IsInRole(Sucursal360.Web.Security.AppRoles.CorporateManager))
                        {
	                            <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">Panel</a>
	                            </li>
	                        }
	                        @if (User.Identity?.IsAuthenticated == true)
	                        {
	                            <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-controller="Reviews" asp-action="Index">Resenas</a>
	                            </li>
	                        }
	                        @if (User.IsInRole(Sucursal360.Web.Security.AppRoles.Administrator) || User.IsInRole(Sucursal360.Web.Security.AppRoles.CorporateManager))
	                        {
	                            <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-controller="Reports" asp-action="Management">Reportes</a>
	                            </li>
	                        }
	                        @if (User.IsInRole(Sucursal360.Web.Security.AppRoles.Administrator))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="AdminBranches" asp-action="Index">Sucursales</a>
                            </li>
	                            <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-controller="AdminIntegrations" asp-action="Index">Integraciones</a>
	                            </li>
	                            <li class="nav-item">
	                                <a class="nav-link text-dark" asp-area="" asp-controller="AdminSimulatedData" asp-action="Import">Datos simulados</a>
	                            </li>
	                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Sucursal 360 - Demo independiente con datos ficticios
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
